p({
  "class":"foam.core.boot.CSpec",
  "name":"JDBCConnectionSpec",
  "lazy":true,
  "serve":false,
  "class":"foam.core.boot.CSpec",
  "service":{
    "class":"foam.dao.jdbc.JDBCConnectionSpec",
    "databaseServer":"postgresql",
    "hostName":"localhost",
    "databaseName":"testSQLDAO",
    "userName":"foam_user",
    "userPassword":"foam_password",
    "port":5432
  }
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "postgresDAO",
  "serviceScript":
  """
  try {
    var jdbcSpec = x.get("JDBCConnectionSpec");
    if ( jdbcSpec == null ) {
      foam.core.logger.StdoutLogger.instance().error("postgresDAO,Error creating PostgresDAO,No JDBCConnectionSpec");
      throw new RuntimeException("No JDBCConnectionSpec");
    }
    source = new foam.dao.jdbc.JDBCPooledDataSource(x, "PoolA");
    x = x.put("JDBCDataSource", source);
    return new foam.dao.jdbc.PostgresDAO(xcopy, getOf());
  } catch (java.sql.SQLException e) {
    foam.core.logger.StdoutLogger.instance().error("postgresDAO,Error creating PostgresDAO", e);
    throw new RuntimeException("Error creating PostgresDAO: " + e.getMessage());
  } catch (ClassNotFoundException e) {
    foam.core.logger.StdoutLogger.instance().error("postgresDAO,Error creating PostgresDAO", e);
    throw new RuntimeException("Error creating PostgresDAO: " + e.getMessage());
  }
  """
})
